{
	"name": "openfit",
	"version": "0.6.5",
	"type": "module",
	"private": true,
	"author": "Paul DiLoreto <soodohh@pm.me>",
	"license": "GPL-3.0-only",
	"bugs": {
		"url": "https://github.com/soodoh/openfit/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/soodoh/openfit.git"
	},
	"trustedDependencies": [
		"@esbuild-kit/core-utils",
		"esbuild",
		"sharp",
		"unrs-resolver"
	],
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"start": "bun run .output/server/index.mjs",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage": "vitest run --coverage --fileParallelism=false",
		"test:e2e": "playwright test",
		"test:e2e:pr": "playwright test --project=chromium --project=chromium-no-auth",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:debug": "playwright test --debug",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"db:init": "./scripts/dev-init.sh",
		"db:migrate": "bun run db/migrate.ts",
		"db:seed": "bun run db/seed.ts",
		"db:seed-mock": "bun run db/seed-mock-user-data.ts"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
