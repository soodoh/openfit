{
	"name": "openfit",
	"version": "0.6.5",
	"type": "module",
	"private": true,
	"author": "Paul DiLoreto <soodohh@pm.me>",
	"license": "GPL-3.0-only",
	"bugs": {
		"url": "https://github.com/soodoh/openfit/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/soodoh/openfit.git"
	},
	"trustedDependencies": [
		"@esbuild-kit/core-utils",
		"esbuild",
		"sharp",
		"unrs-resolver"
	],
	"scripts": {
		"dev": "bun --bun vite dev",
		"build": "bun --bun vite build",
		"start": "bun run .output/server/index.mjs",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"test": "vitest",
		"test:run": "vitest run",
		"test:coverage:unit": "vitest run --coverage --fileParallelism=false && npx tsx scripts/merge-coverage.ts --mode unit && bun scripts/check-coverage.ts --mode unit",
		"test:coverage": "vitest run --coverage --fileParallelism=false && COLLECT_COVERAGE=true playwright test --project=setup --project=chromium && npx tsx scripts/merge-coverage.ts --mode merged && bun scripts/check-coverage.ts --mode merged",
		"test:e2e": "playwright test",
		"test:e2e:ui": "playwright test --ui",
		"test:e2e:headed": "playwright test --headed",
		"test:e2e:debug": "playwright test --debug",
		"db:generate": "drizzle-kit generate",
		"db:studio": "drizzle-kit studio",
		"db:init": "./scripts/dev-init.sh",
		"db:migrate": "bun run db/migrate.ts",
		"db:seed": "bun run db/seed.ts",
		"db:seed-mock": "bun run db/seed-mock-user-data.ts"
	},
	"dependencies": {
		"@dnd-kit/core": "^6.3.1",
		"@dnd-kit/sortable": "^10.0.0",
		"@dnd-kit/utilities": "^3.2.2",
		"@paralleldrive/cuid2": "^3.3.0",
		"@radix-ui/react-avatar": "^1.1.11",
		"@radix-ui/react-checkbox": "^1.3.3",
		"@radix-ui/react-collapsible": "^1.1.12",
		"@radix-ui/react-dialog": "^1.1.15",
		"@radix-ui/react-dropdown-menu": "^2.1.16",
		"@radix-ui/react-label": "^2.1.8",
		"@radix-ui/react-popover": "^1.1.15",
		"@radix-ui/react-select": "^2.2.6",
		"@radix-ui/react-separator": "^1.1.8",
		"@radix-ui/react-slot": "^1.2.4",
		"@radix-ui/react-switch": "^1.2.6",
		"@radix-ui/react-tabs": "^1.1.13",
		"@tailwindcss/vite": "^4.3.0",
		"@tanstack/react-query": "^5.100.14",
		"@tanstack/react-query-devtools": "^5.100.14",
		"@tanstack/react-router": "^1.170.8",
		"@tanstack/react-router-devtools": "^1.167.0",
		"@tanstack/react-start": "^1.168.14",
		"@unpic/react": "^1.0.2",
		"better-auth": "^1.6.11",
		"cmdk": "^1.1.1",
		"date-fns": "^4.3.0",
		"dayjs": "^1.11.21",
		"drizzle-orm": "^0.45.2",
		"embla-carousel-react": "^8.6.0",
		"lucide-react": "^1.16.0",
		"nanoid": "^5.1.11",
		"next-themes": "^0.4.6",
		"nitro": "^3.0.260311-beta",
		"react": "19.2.6",
		"react-day-picker": "^10.0.1",
		"react-dom": "19.2.6",
		"vite": "^8.0.14",
		"zod": "^4.4.3"
	},
	"devDependencies": {
		"@playwright/test": "^1.60.0",
		"@types/node": "^25.9.1",
		"@types/react": "^19.2.15",
		"@types/react-dom": "^19.2.3",
		"@vitejs/plugin-react": "^6.0.2",
		"@vitest/browser": "^4.1.7",
		"@vitest/browser-playwright": "^4.1.7",
		"class-variance-authority": "^0.7.1",
		"dotenv": "^17.4.2",
		"dotenv-expand": "^13.0.0",
		"drizzle-kit": "^0.31.10",
		"monocart-coverage-reports": "^2.12.11",
		"monocart-reporter": "^2.11.2",
		"playwright": "^1.60.0",
		"tailwind-merge": "^3.6.0",
		"tailwindcss": "^4.3.0",
		"tsx": "^4.22.3",
		"typescript": "^6.0.3",
		"vitest": "4.1.7",
		"vitest-browser-react": "^2.2.0",
		"vitest-monocart-coverage": "^4.0.2",
		"wait-on": "^9.0.10"
	}
}
